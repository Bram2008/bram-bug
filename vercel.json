{
  "version": 2,
  "functions": {
    "api/bot.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/bot", "dest": "/api/bot.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    }
  ]
}
